{
  "description": "Global lifecycle hooks shared through the codex-skills repository.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^compact$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.codex/hooks/restore_recent_context.py",
            "commandWindows": "& \"$env:USERPROFILE\\.cache\\codex-runtimes\\codex-primary-runtime\\dependencies\\python\\python.exe\" \"$env:USERPROFILE\\.codex\\hooks\\restore_recent_context.py\"",
            "timeout": 10,
            "statusMessage": "Restoring recent conversation context"
          }
        ]
      }
    ]
  }
}
